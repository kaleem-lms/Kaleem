@@ -0,0 +1,63 @@
+"""SPIKE P1 (msg-realtime-adr): never committed.
+
+Per-request cost of an authenticated GET /api/v1/identity/me/ through the Django
+test client -- a LOWER-BOUND proxy for a polled messaging endpoint, which does
+not exist yet. The test client omits gunicorn, the network and the production
+middleware stack, so the real cost is higher.
+
+Positive control first: a 50 ms sleep injected into the view's path must raise
+the measured mean by at least 50 ms, or the instrument cannot see a cost.
+"""
+
+import statistics
+import time
+
+import pytest
+from django.contrib.auth import get_user_model
+from django.test import Client
+
+from kaleem.identity.api import views
+
+ME = "/api/v1/identity/me/"
+
+
+@pytest.fixture
+def client(db):
+    user = get_user_model().objects.create_user(email="poll@example.com", password="pw-not-real-1", full_name="Poll")
+    http = Client()
+    http.force_login(user)
+    return http
+
+
+def measure(client, n):
+    for _ in range(20):  # warm-up
+        assert client.get(ME).status_code == 200
+    samples = []
+    for _ in range(n):
+        start = time.perf_counter()
+        response = client.get(ME)
+        samples.append((time.perf_counter() - start) * 1000)
+        assert response.status_code == 200
+    return samples
+
+
+def test_positive_control_sees_an_injected_50ms_sleep(client, monkeypatch):
+    clean = statistics.mean(measure(client, 100))
+    original = views._me_payload  # noqa: SLF001
+
+    def slow(user):
+        time.sleep(0.05)
+        return original(user)
+
+    monkeypatch.setattr(views, "_me_payload", slow)
+    slowed = statistics.mean(measure(client, 100))
+    print(f"\nP1-CONTROL clean_mean_ms={clean:.2f} slowed_mean_ms={slowed:.2f} delta_ms={slowed - clean:.2f}")
+    assert slowed - clean >= 50
+
+
+def test_poll_cost(client):
+    samples = sorted(measure(client, 2000))
+    mean = statistics.mean(samples)
+    print(
+        f"\nP1 n=2000 mean_ms={mean:.3f} p50_ms={samples[1000]:.3f} p99_ms={samples[1980]:.3f} max_ms={samples[-1]:.3f}"
+    )
