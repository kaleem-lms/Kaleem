new file mode 100644
index 0000000..c812198
--- /dev/null
+++ b/signaling/handshake.py
@@ -0,0 +1,28 @@
+"""SPIKE: the subprotocol handshake shared by the room and inbox routes,
+moved out of app.py so inbox.py does not import app.py."""
+
+from __future__ import annotations
+
+import os
+
+from starlette.websockets import WebSocket
+
+CLOSE_UNAUTHORIZED = 4401
+SUBPROTOCOL = "kaleem.signaling.v1"
+
+
+def secret() -> str:
+    value = os.environ.get("DJANGO_SIGNALING_SECRET", "")
+    if not value:
+        message = "DJANGO_SIGNALING_SECRET is not set"
+        raise RuntimeError(message)
+    return value
+
+
+def offered_credential(websocket: WebSocket) -> tuple[bool, str]:
+    raw = ",".join(websocket.headers.getlist("sec-websocket-protocol"))
+    offered = [part.strip() for part in raw.split(",") if part.strip()]
+    offered_protocol = SUBPROTOCOL in offered
+    if len(offered) != 2 or offered[0] != SUBPROTOCOL:
+        return offered_protocol, ""
+    return offered_protocol, offered[1]
