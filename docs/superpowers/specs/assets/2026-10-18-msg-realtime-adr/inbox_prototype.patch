+++ b/signaling/tests/test_spike_inbox.py
@@ -0,0 +1,115 @@
+"""SPIKE (msg-realtime-adr): never committed. Proves the token-purpose control
+the inbox route needs under options 1 and 2."""
+
+import base64
+import json
+import signal
+import time
+
+import pytest
+from starlette.testclient import TestClient
+from starlette.websockets import WebSocketDisconnect
+
+from signaling.app import CLOSE_UNAUTHORIZED
+from signaling.app import SUBPROTOCOL
+from signaling.app import app
+from signaling.inbox import registry as inbox_registry
+from signaling.tokens import InboxToken
+from signaling.tokens import RoomToken
+from signaling.tokens import TokenError
+from signaling.tokens import _sign
+from signaling.tokens import mint
+from signaling.tokens import mint_inbox
+from signaling.tokens import verify
+from signaling.tokens import verify_inbox
+
+SECRET = "test-secret-not-a-real-one"
+
+
+@pytest.fixture(autouse=True)
+def _secret(monkeypatch):
+    monkeypatch.setenv("DJANGO_SIGNALING_SECRET", SECRET)
+
+
+def _exp(ttl=300):
+    return int(time.time()) + ttl
+
+
+def room_token(room="r1", user=1):
+    return mint(RoomToken(room_id=room, user_id=user, is_teacher=False, expires_at=_exp()), SECRET)
+
+
+def inbox_token(user=1, ttl=300):
+    return mint_inbox(InboxToken(user_id=user, expires_at=_exp(ttl)), SECRET)
+
+
+def _closes_with(url, token):
+    """The close code the server answers with. An ACCEPTED socket would block
+    here forever, so a wrongly accepted token fails the test instead of
+    hanging it."""
+
+    def _timed_out(*_):
+        message = "socket was accepted and held open"
+        raise AssertionError(message)
+
+    signal.signal(signal.SIGALRM, _timed_out)
+    signal.alarm(3)
+    try:
+        client = TestClient(app)
+        with client.websocket_connect(url, subprotocols=[SUBPROTOCOL, token]) as ws:
+            with pytest.raises(WebSocketDisconnect) as exc:
+                ws.receive_text()
+        return exc.value.code
+    finally:
+        signal.alarm(0)
+
+
+def test_room_token_is_refused_on_inbox():
+    assert _closes_with("/ws/inbox", room_token()) == CLOSE_UNAUTHORIZED
+
+
+def test_inbox_token_is_refused_on_room():
+    assert _closes_with("/ws/rooms/r1", inbox_token()) == CLOSE_UNAUTHORIZED
+
+
+def test_inbox_token_is_accepted_and_seated():
+    client = TestClient(app)
+    with client.websocket_connect("/ws/inbox", subprotocols=[SUBPROTOCOL, inbox_token(7)]) as ws:
+        ws.send_text("hello")
+        assert len(inbox_registry.sockets(7)) == 1
+    assert inbox_registry.sockets(7) == []
+
+
+def test_expired_inbox_token_is_refused():
+    assert _closes_with("/ws/inbox", inbox_token(ttl=-10)) == CLOSE_UNAUTHORIZED
+
+
+def _forge(claims, key_of):
+    payload = base64.urlsafe_b64encode(json.dumps(claims, sort_keys=True).encode()).decode().rstrip("=")
+    return f"{payload}.{_sign(payload, key_of)}"
+
+
+def test_inbox_signature_is_not_the_room_signature():
+    """Layer 1: the keys differ. Inbox-shaped claims signed with the ROOM key
+    are refused by the inbox verifier, so a leaked room secret path alone is
+    not enough and a room token cannot be re-labelled."""
+    claims = {"purpose": "inbox", "user_id": 1, "expires_at": _exp()}
+    with pytest.raises(TokenError, match="bad signature"):
+        verify_inbox(_forge(claims, SECRET), SECRET)
+
+
+def test_room_verifier_refuses_an_inbox_signed_token():
+    from signaling.tokens import _inbox_key
+
+    claims = {"room_id": "r1", "user_id": 1, "is_teacher": False, "expires_at": _exp()}
+    with pytest.raises(TokenError, match="bad signature"):
+        verify(_forge(claims, _inbox_key(SECRET)), SECRET)
+
+
+def test_inbox_claims_must_name_the_inbox_purpose():
+    """Layer 2: right key, wrong claim set."""
+    from signaling.tokens import _inbox_key
+
+    claims = {"user_id": 1, "expires_at": _exp()}
+    with pytest.raises(TokenError, match="malformed payload"):
+        verify_inbox(_forge(claims, _inbox_key(SECRET)), SECRET)
diff --git a/signaling/tokens.py b/signaling/tokens.py
index d7c925c..f6c71f1 100644
--- a/signaling/tokens.py
+++ b/signaling/tokens.py
@@ -108,3 +108,52 @@ def verify(raw: str, secret: str, *, now: int | None = None) -> RoomToken:
     if now > token.expires_at:
         raise TokenError("expired")
     return token
+
+
+# --- SPIKE (msg-realtime-adr): a second token purpose --------------------------
+#
+# The control an inbox route needs under options 1 and 2: a room token must not
+# open an inbox and an inbox token must not open a room. Two independent layers,
+# each tested on its own: the HMAC key is derived per purpose, and the claim set
+# names the purpose.
+
+INBOX_PURPOSE = "inbox"
+
+
+@dataclass(frozen=True)
+class InboxToken:
+    user_id: int
+    expires_at: int
+
+
+def _inbox_key(secret: str) -> str:
+    return hmac.new(secret.encode(), b"kaleem.inbox.v1", hashlib.sha256).hexdigest()
+
+
+def mint_inbox(token: InboxToken, secret: str) -> str:
+    claims = {"purpose": INBOX_PURPOSE, **asdict(token)}
+    payload = _b64(json.dumps(claims, sort_keys=True).encode())
+    return f"{payload}.{_sign(payload, _inbox_key(secret))}"
+
+
+def verify_inbox(raw: str, secret: str, *, now: int | None = None) -> InboxToken:
+    if now is None:
+        now = int(time.time())
+    parts = raw.split(".")
+    if len(parts) != 2 or not all(parts) or not raw.isascii():
+        raise TokenError("malformed token")
+    payload, signature = parts
+    if not hmac.compare_digest(signature, _sign(payload, _inbox_key(secret))):
+        raise TokenError("bad signature")
+    try:
+        claims = json.loads(_unb64(payload))
+        if claims.pop("purpose", None) != INBOX_PURPOSE:
+            raise TokenError("malformed payload")
+        token = InboxToken(**claims)
+    except Exception as exc:
+        raise TokenError("malformed payload") from exc
+    if not isinstance(token.user_id, int) or not isinstance(token.expires_at, int):
+        raise TokenError("malformed payload")
+    if now > token.expires_at:
+        raise TokenError("expired")
+    return token
