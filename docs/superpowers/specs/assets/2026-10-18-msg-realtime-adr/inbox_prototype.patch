index 0000000..fc19c8b
--- /dev/null
+++ b/signaling/inbox.py
@@ -0,0 +1,110 @@
+"""SPIKE (msg-realtime-adr): a per-user inbox socket. Never merged.
+
+One socket per browser tab, keyed by user id. Messages arrive over Redis
+pub/sub (`inbox:<user_id>`), which stands in for publish-on-commit.
+"""
+
+from __future__ import annotations
+
+import contextlib
+import logging
+import os
+from collections import defaultdict
+from typing import Any
+
+from starlette.websockets import WebSocket
+from starlette.websockets import WebSocketDisconnect
+
+from signaling.handshake import CLOSE_UNAUTHORIZED
+from signaling.handshake import SUBPROTOCOL
+from signaling.handshake import offered_credential
+from signaling.handshake import secret
+from signaling.tokens import TokenError
+from signaling.tokens import verify_inbox
+
+logger = logging.getLogger(__name__)
+
+REDIS_URL_ENV = "SIGNALING_INBOX_REDIS_URL"
+
+
+class InboxRegistry:
+    def __init__(self) -> None:
+        self._sockets: dict[int, list[Any]] = defaultdict(list)
+
+    def add(self, user_id: int, socket: Any) -> None:
+        self._sockets[user_id].append(socket)
+
+    def remove(self, user_id: int, socket: Any) -> None:
+        remaining = [s for s in self._sockets.get(user_id, []) if s is not socket]
+        if remaining:
+            self._sockets[user_id] = remaining
+        else:
+            self._sockets.pop(user_id, None)
+
+    def sockets(self, user_id: int) -> list:
+        return list(self._sockets.get(user_id, []))
+
+    def count(self) -> int:
+        return sum(len(v) for v in self._sockets.values())
+
+
+registry = InboxRegistry()
+
+
+async def on_frame(websocket: WebSocket, user_id: int, raw: str) -> None:
+    """A client sends nothing meaningful on the inbox. Module-level so a test
+    or a fault-injection harness can replace it."""
+
+
+async def deliver(socket: Any, data: str) -> None:
+    with contextlib.suppress(Exception):
+        await socket.send_text(data)
+
+
+async def inbox_endpoint(websocket: WebSocket) -> None:
+    offered_protocol, raw = offered_credential(websocket)
+    try:
+        token = verify_inbox(raw, secret())
+    except TokenError as exc:
+        logger.warning("refused inbox join: %s", exc)
+        await websocket.accept(subprotocol=SUBPROTOCOL if offered_protocol else None)
+        await websocket.close(code=CLOSE_UNAUTHORIZED)
+        return
+
+    await websocket.accept(subprotocol=SUBPROTOCOL)
+    registry.add(token.user_id, websocket)
+    try:
+        while True:
+            await on_frame(websocket, token.user_id, await websocket.receive_text())
+    except WebSocketDisconnect:
+        pass
+    finally:
+        registry.remove(token.user_id, websocket)
+
+
+async def run_subscriber(redis_url: str) -> None:
+    import redis.asyncio as aioredis
+
+    client = aioredis.from_url(redis_url)
+    pubsub = client.pubsub()
+    await pubsub.psubscribe("inbox:*")
+    async for message in pubsub.listen():
+        if message["type"] != "pmessage":
+            continue
+        user_id = int(message["channel"].decode().split(":", 1)[1])
+        data = message["data"].decode()
+        for socket in registry.sockets(user_id):
+            await deliver(socket, data)
+
+
+@contextlib.asynccontextmanager
+async def lifespan(app: Any):
+    import asyncio
+
+    url = os.environ.get(REDIS_URL_ENV)
+    task = asyncio.create_task(run_subscriber(url)) if url else None
+    try:
+        yield
+    finally:
+        if task is not None:
+            task.cancel()
